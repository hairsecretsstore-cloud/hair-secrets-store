# ---------------------------------------------------------------------------
# Hair Secrets Store — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Site (use https://hairsecretsstore.co in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# DHL Shipment Tracking – Unified API (self-service, single key) → powers /track
DHL_TRACKING_API_KEY=your-dhl-tracking-api-key

# DHL Express – MyDHL API (rates + label/shipment creation; needs Express account)
DHL_API_ENV=test                                  # test | production
DHL_API_KEY=your-dhl-key
DHL_API_SECRET=your-dhl-secret
DHL_ACCOUNT_NUMBER=your-dhl-account

# Email — Resend (resend.com) for order/shipping notifications
RESEND_API_KEY=your-resend-key
EMAIL_FROM=Hair Secrets Store <orders@hairsecretsstore.co>

# DPO Pay (docs.dpopay.com)
DPO_COMPANY_TOKEN=your-company-token
DPO_SERVICE_TYPE=3854                              # your configured service id
